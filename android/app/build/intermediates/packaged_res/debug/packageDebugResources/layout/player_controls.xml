<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/controls_layout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="visible">

        <ImageView
            android:id="@+id/back"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/back"
            android:layout_margin="10dp"
            android:padding="10dp"
            android:layout_gravity="start"
            android:background="@drawable/focus_highlight"
            android:enabled="false"/>

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:padding="10dp"
            android:textColor="#ffffff"
            android:text="Video Title"
            android:layout_weight="1"
            android:textSize="16sp"
            android:gravity="center"
            android:enabled="false"/>

        <ImageView
            android:id="@+id/select_tracks_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/gear"
            android:layout_margin="10dp"
            android:padding="10dp"
            android:layout_gravity="end"
            android:background="@drawable/focus_highlight"
            android:enabled="false"/>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/playback_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_centerInParent="true">

        <ImageView
            android:id="@+id/backwardButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/backward"
            android:background="@drawable/focus_highlight"

            android:layout_marginEnd="16dp" />


        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp">

            <ImageView
                android:id="@+id/playPauseButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/play"
                android:layout_gravity="center"
                android:background="@drawable/focus_highlight"
                />
            <!--    <ProgressBar
                    android:id="@+id/progressbar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/play"
                    android:layout_gravity="center"
                    android:background="@drawable/focus_highlight"
                     />-->

        </FrameLayout>





        <ImageView
            android:id="@+id/forwardButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/focus_highlight"
            android:src="@drawable/forwardd"
            android:layout_marginStart="16dp" />

    </LinearLayout>

   <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/currentTimeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/totalTimeTextView"
            android:layout_toEndOf="@+id/currentTimeTextView"
            android:progressTint="#FF3830"
            android:thumbTint="#FF7A00"
            android:progressBackgroundTint="#FFFFFF"
            android:padding="8dp" />
        <TextView
            android:id="@+id/totalTimeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/muteButton"
            android:layout_centerVertical="true"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/muteButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/unmutenw"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/focus_highlight"
            android:padding="4dp" />

    </RelativeLayout>

</RelativeLayout>